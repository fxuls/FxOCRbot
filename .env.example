# Copy to .env and fill in. .env is gitignored. Never commit a real token.

# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional (defaults shown)
# FXOCR_ENGINE=tesseract           # default engine for users who haven't picked one with /engine:
#                                  # tesseract | ppocr | ocria-nano (ocria-nano needs WITH_OCRIA_NANO=1;
#                                  # read docs/engines.md for its licence first)
# WITH_OCRIA_NANO=0                # 1 = download OCRia-nano-1 weights at image build
# FXOCR_DATA_DIR=/data             # where per-user engine choices are stored (set in the image)
# FXOCR_MAX_FILE_MB=10             # largest upload accepted
# FXOCR_MAX_PIXELS=40000000        # largest decoded image (decompression-bomb guard)
# FXOCR_MAX_SIDE=4000              # images are downscaled to this longest side before OCR
# FXOCR_TIMEOUT_S=60               # wall-clock limit per OCR job
# FXOCR_WORKER_MEM_MB=8192         # virtual address-space cap per OCR worker (ONNX Runtime reserves
#                                  # far more than it uses; real RAM is capped by the container)
# FXOCR_CONCURRENCY=2              # OCR jobs running at once (whole bot)
# FXOCR_QUEUE_MAX=20               # jobs waiting before new ones get "busy, try later"
# FXOCR_USER_RATE=6                # images per user per window
# FXOCR_USER_WINDOW_S=60
# FXOCR_LOG_LEVEL=INFO
